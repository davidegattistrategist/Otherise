# Copia questo file in .env.local (sviluppo) oppure inserisci le stesse
# variabili su Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Indirizzo pubblico dell'app, senza "/" finale
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Assistente AI (console.anthropic.com). ANTHROPIC_MODEL è facoltativo.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Email di avviso (resend.com). Facoltative: senza, restano le notifiche in app.
RESEND_API_KEY=
EMAIL_FROM="Otherise <avvisi@tuodominio.it>"

# Protegge i controlli automatici giornalieri: una frase lunga a caso
CRON_SECRET=
